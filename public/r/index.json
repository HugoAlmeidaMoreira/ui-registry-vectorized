{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "ui-registry-vectorized",
  "homepage": "https://github.com/HugoAlmeidaMoreira/ui-registry-vectorized",
  "items": [
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "custom-switch",
      "type": "registry:ui",
